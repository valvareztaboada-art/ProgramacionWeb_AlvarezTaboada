# Copiá este archivo como .env.local y completá con los datos de tu proyecto de Supabase
# (Supabase → Project Settings → API Keys / Data API).
# .env.local NO se sube a GitHub. En Vercel, estas mismas variables se cargan en
# Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# La clave "publishable" (sb_publishable_...) o la "anon" de la sección Legacy. Es pública:
# lo que cada usuario puede hacer lo limita el RLS. NUNCA uses acá la "secret" / "service_role".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
