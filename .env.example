# Copiá este archivo como .env.local y completá con tus datos.
# .env.local NO se sube a GitHub. En Vercel, estas mismas variables se cargan en
# Settings → Environment Variables.
#
# Regla de oro: lo que empieza con NEXT_PUBLIC_ llega al navegador (es público).
# Lo que NO empieza con NEXT_PUBLIC_ queda solo en el servidor (secretos).

# ---------- Supabase (Project Settings → API Keys / Data API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave "publishable" (sb_publishable_...). Es pública: lo que cada usuario puede hacer lo limita el RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# 🔒 Clave "secret" (sb_secret_...). SECRETA: saltea el RLS. Solo la usa el webhook de Mercado Pago.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# ---------- Mercado Pago (Tus integraciones → tu aplicación) ----------
# 🔒 Access Token de PRUEBA (Credenciales de prueba). SECRETO: nunca en el frontend.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# 🔒 Clave secreta de los webhooks (Webhooks → Configurar notificaciones → Clave secreta).
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
